# /etc/nginx/sites-available/streaming   (then: certbot --nginx -d stream.example.com)
#
# nginx only carries the web page and the socket.io signaling. The video does NOT go through nginx:
# browsers connect straight to RTC_PORT (UDP + TCP) on the server, so open that port in the firewall.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name stream.example.com;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # WebSocket (socket.io)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # keep idle signaling sockets open
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
