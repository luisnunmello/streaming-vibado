# Copy to .env (docker compose reads it automatically).

# REQUIRED in production: the public IP of your server. Browsers send video to this address.
MEDIASOUP_ANNOUNCED_IP=203.0.113.10

# Port used for all WebRTC traffic, open it in your firewall for BOTH UDP and TCP.
RTC_PORT=40000

# Local port nginx proxies to (bound to 127.0.0.1 only).
PORT=3000

# Initial master password (first start only). Leave empty to generate one and print it in the logs.
# Sign in at /login as "admin" and change it under Account.
ADMIN_PASSWORD=

# Starting values for the bandwidth budgets, in Mbps (changeable later on the Bandwidth page).
# Egress = what the server uploads to viewers: keep it around 70% of your real upload speed.
EGRESS_BUDGET_MBPS=500
INGRESS_BUDGET_MBPS=800
